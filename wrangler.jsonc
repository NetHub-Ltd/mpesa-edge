{
    "name": "mpesa-edge",
    "main": "src/entry.py",
    "compatibility_date": "2026-08-20",
    "compatibility_flags": [
        "python_workers",
        "disable_python_external_sdk"
    ],
    "observability": {
        "enabled": true
    },
    "queues": {
        "producers": [
            {
                "binding": "MPESA_QUEUE",
                "queue": "mpesa-callbacks"
            }
        ]
    }
}